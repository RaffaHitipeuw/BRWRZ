{
  "name": "mesh-engine-ui",
  "version": "0.1.5",
  "private": true,
  "description": "React islands for the Mesh Engine UI. Bundled with esbuild into classic IIFE scripts because the shell is served from file:// URLs (ES modules are blocked there).",
  "scripts": {
    "build:ui": "node ui-react/build.mjs",
    "dev:ui": "node ui-react/build.mjs --watch"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@flaticon/flaticon-uicons": "^3.3.1",
    "@tailwindcss/cli": "^4.3.5",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.5",
    "tw-fade": "^0.10.0"
  }
}
